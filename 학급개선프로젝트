<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI 프롬프트 최적화 도우미</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #f7f6f2;
    --surface: #ffffff;
    --surface2: #f0efe9;
    --border: #e2e0d8;
    --text: #1a1917;
    --text2: #5a5854;
    --text3: #9a9790;
    --accent: #4a3fa0;
    --accent-light: #eeedfe;
    --accent-text: #3c3489;
    --success: #1d9e75;
    --success-light: #e1f5ee;
    --warn: #ba7517;
    --warn-light: #faeeda;
    --radius: 12px;
    --radius-sm: 8px;
  }

  body {
    font-family: 'Pretendard', 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    line-height: 1.6;
  }

  /* HEADER */
  header {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    padding: 0 24px;
    height: 60px;
    display: flex;
    align-items: center;
    gap: 12px;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .logo-dot {
    width: 28px; height: 28px;
    background: var(--accent);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .logo-dot svg { width: 16px; height: 16px; fill: white; }
  header h1 { font-size: 15px; font-weight: 600; color: var(--text); letter-spacing: -0.3px; }
  .badge-exp {
    margin-left: auto;
    font-size: 11px; font-weight: 600;
    background: var(--accent-light); color: var(--accent-text);
    padding: 3px 10px; border-radius: 20px;
  }

  /* MAIN LAYOUT */
  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }

  /* HERO */
  .hero {
    text-align: center;
    margin-bottom: 48px;
  }
  .hero-eyebrow {
    font-size: 12px; font-weight: 600; letter-spacing: 1.5px;
    color: var(--accent); text-transform: uppercase;
    margin-bottom: 12px;
  }
  .hero h2 {
    font-size: clamp(24px, 5vw, 36px);
    font-weight: 700;
    letter-spacing: -0.8px;
    line-height: 1.25;
    color: var(--text);
    margin-bottom: 14px;
  }
  .hero h2 span { color: var(--accent); }
  .hero p {
    font-size: 15px; color: var(--text2);
    max-width: 480px; margin: 0 auto;
    line-height: 1.7;
  }

  /* STEP INDICATOR */
  .steps {
    display: flex; align-items: center; justify-content: center;
    gap: 0; margin-bottom: 40px;
  }
  .step-item {
    display: flex; align-items: center; gap: 8px;
  }
  .step-num {
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--surface2); border: 1.5px solid var(--border);
    font-size: 12px; font-weight: 600; color: var(--text3);
    display: flex; align-items: center; justify-content: center;
    transition: all 0.25s;
  }
  .step-label { font-size: 12px; color: var(--text3); font-weight: 500; }
  .step-item.active .step-num { background: var(--accent); border-color: var(--accent); color: white; }
  .step-item.active .step-label { color: var(--text); }
  .step-item.done .step-num { background: var(--success); border-color: var(--success); color: white; }
  .step-connector { width: 40px; height: 1.5px; background: var(--border); margin: 0 4px; }

  /* SECTION */
  .section { margin-bottom: 32px; }
  .section-label {
    font-size: 13px; font-weight: 600; color: var(--text2);
    letter-spacing: 0.5px; margin-bottom: 14px;
    display: flex; align-items: center; gap: 8px;
  }
  .section-label::after { content: ''; flex: 1; height: 1px; background: var(--border); }

  /* FIELD GRID */
  .field-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 10px;
  }
  .field-btn {
    padding: 16px 12px;
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    text-align: center;
    transition: all 0.18s;
    display: flex; flex-direction: column; align-items: center; gap: 8px;
  }
  .field-btn:hover { border-color: var(--accent); background: var(--accent-light); }
  .field-btn.selected { border-color: var(--accent); background: var(--accent-light); }
  .field-icon { font-size: 22px; line-height: 1; }
  .field-name { font-size: 13px; font-weight: 600; color: var(--text); }
  .field-sub { font-size: 11px; color: var(--text3); margin-top: 2px; }

  /* TASK TYPE */
  .task-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 10px;
  }
  .task-btn {
    padding: 13px 14px;
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.18s;
    display: flex; align-items: center; gap: 10px;
  }
  .task-btn:hover { border-color: var(--accent); background: var(--accent-light); }
  .task-btn.selected { border-color: var(--accent); background: var(--accent-light); }
  .task-check {
    width: 18px; height: 18px; border-radius: 50%;
    border: 1.5px solid var(--border); flex-shrink: 0;
    background: white; display: flex; align-items: center; justify-content: center;
  }
  .task-btn.selected .task-check { background: var(--accent); border-color: var(--accent); }
  .task-check-inner { width: 7px; height: 7px; border-radius: 50%; background: white; }
  .task-text { font-size: 13px; font-weight: 500; color: var(--text); }

  /* FREE INPUT */
  .free-input-wrap { position: relative; }
  .free-input-wrap textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    font-size: 14px;
    color: var(--text);
    background: var(--surface);
    resize: none;
    font-family: inherit;
    line-height: 1.6;
    transition: border-color 0.18s;
    outline: none;
  }
  .free-input-wrap textarea:focus { border-color: var(--accent); }
  .char-count { font-size: 11px; color: var(--text3); text-align: right; margin-top: 6px; }

  /* GENERATE BUTTON */
  .generate-wrap { text-align: center; margin-top: 32px; }
  #generateBtn {
    padding: 14px 40px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: var(--radius);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: -0.2px;
    transition: all 0.18s;
    display: inline-flex; align-items: center; gap: 8px;
  }
  #generateBtn:hover { background: #3c3489; transform: translateY(-1px); }
  #generateBtn:disabled { background: var(--border); color: var(--text3); cursor: not-allowed; transform: none; }
  .btn-icon { font-size: 18px; }

  /* RESULT */
  #result {
    margin-top: 40px;
    display: none;
    animation: fadeUp 0.4s ease;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .result-header {
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 20px;
  }
  .result-tag {
    font-size: 11px; font-weight: 700; letter-spacing: 1px;
    text-transform: uppercase;
    background: var(--success-light); color: var(--success);
    padding: 4px 12px; border-radius: 20px;
  }
  .result-title { font-size: 17px; font-weight: 600; color: var(--text); }

  /* PROMPT BOX */
  .prompt-box {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .prompt-box-header {
    padding: 12px 16px;
    background: var(--surface2);
    border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
  }
  .prompt-box-label { font-size: 12px; font-weight: 600; color: var(--text2); }
  #copyBtn {
    padding: 5px 14px;
    background: var(--accent);
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
    display: flex; align-items: center; gap: 5px;
  }
  #copyBtn:hover { background: #3c3489; }
  #copyBtn.copied { background: var(--success); }
  #promptText {
    padding: 20px 20px;
    font-size: 14px;
    line-height: 1.75;
    color: var(--text);
    white-space: pre-wrap;
    min-height: 80px;
  }

  /* CONDITIONS USED */
  .conditions-row {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin-top: 16px; margin-bottom: 24px;
  }
  .cond-tag {
    font-size: 12px; font-weight: 600;
    padding: 5px 12px; border-radius: 20px;
    display: flex; align-items: center; gap: 5px;
  }
  .cond-tag.top { background: #faeeda; color: #854f0b; }
  .cond-tag.high { background: var(--accent-light); color: var(--accent-text); }
  .cond-tag.good { background: var(--success-light); color: #085041; }
  .cond-score { font-weight: 800; }

  /* SCORE MINI CARDS */
  .score-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
    margin-top: 20px;
  }
  @media (max-width: 600px) {
    .score-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .score-card {
    background: var(--surface2);
    border-radius: var(--radius-sm);
    padding: 12px 8px;
    text-align: center;
  }
  .score-card-label { font-size: 10px; color: var(--text3); margin-bottom: 6px; line-height: 1.3; }
  .score-card-num { font-size: 18px; font-weight: 700; color: var(--accent); }
  .score-bar-wrap { height: 3px; background: var(--border); border-radius: 2px; margin-top: 6px; overflow: hidden; }
  .score-bar { height: 100%; background: var(--accent); border-radius: 2px; transition: width 0.8s ease; }

  /* TIP BOX */
  .tip-box {
    background: var(--accent-light);
    border: 1px solid #afa9ec;
    border-radius: var(--radius);
    padding: 16px 20px;
    margin-top: 20px;
    display: flex; gap: 12px;
  }
  .tip-icon { font-size: 18px; flex-shrink: 0; margin-top: 1px; }
  .tip-content { font-size: 13px; color: var(--accent-text); line-height: 1.65; }
  .tip-content strong { font-weight: 700; }

  /* LOADING */
  .loading-wrap {
    display: none;
    text-align: center;
    padding: 40px 0;
  }
  .loading-dots { display: flex; justify-content: center; gap: 6px; }
  .loading-dots span {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent); opacity: 0.3;
    animation: dot 1.2s infinite;
  }
  .loading-dots span:nth-child(2) { animation-delay: 0.2s; }
  .loading-dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes dot { 0%, 80%, 100% { opacity: 0.3; } 40% { opacity: 1; } }
  .loading-text { font-size: 13px; color: var(--text3); margin-top: 12px; }

  /* FOOTER */
  .footer-note {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    text-align: center;
    font-size: 12px; color: var(--text3);
    line-height: 1.7;
  }
  .footer-note strong { color: var(--text2); }

  /* ERROR */
  .error-box {
    background: #fcebeb;
    border: 1px solid #f09595;
    border-radius: var(--radius);
    padding: 14px 18px;
    font-size: 13px; color: #791f1f;
    margin-top: 16px;
    display: none;
  }

  /* API KEY INPUT */
  .apikey-section {
    background: var(--warn-light);
    border: 1px solid #fac775;
    border-radius: var(--radius);
    padding: 16px 20px;
    margin-bottom: 32px;
    display: flex; align-items: flex-start; gap: 12px;
  }
  .apikey-section .warn-icon { font-size: 18px; flex-shrink: 0; margin-top: 2px; }
  .apikey-content { flex: 1; }
  .apikey-content p { font-size: 13px; color: #633806; margin-bottom: 10px; line-height: 1.6; }
  .apikey-content p strong { font-weight: 700; }
  .apikey-row { display: flex; gap: 8px; }
  .apikey-row input {
    flex: 1; padding: 9px 13px;
    border: 1.5px solid #fac775;
    border-radius: var(--radius-sm);
    font-size: 13px; background: white; color: var(--text);
    outline: none; font-family: monospace;
  }
  .apikey-row input:focus { border-color: var(--warn); }
  .apikey-row button {
    padding: 9px 16px;
    background: var(--warn); color: white;
    border: none; border-radius: var(--radius-sm);
    font-size: 13px; font-weight: 600; cursor: pointer;
  }
  .apikey-row button:hover { background: #854f0b; }
  .apikey-status { font-size: 12px; margin-top: 6px; }
  .apikey-status.ok { color: var(--success); }
  .apikey-status.no { color: #a32d2d; }
</style>
</head>
<body>

<header>
  <div class="logo-dot">
    <svg viewBox="0 0 20 20"><path d="M10 2L12.5 7.5H18L13.5 11L15.5 17L10 13.5L4.5 17L6.5 11L2 7.5H7.5L10 2Z"/></svg>
  </div>
  <h1>AI 프롬프트 최적화 도우미</h1>
  <span class="badge-exp">실험 검증 v1.0</span>
</header>

<main>
  <div class="hero">
    <div class="hero-eyebrow">학급 개선 프로젝트 · 10학년</div>
    <h2>AI에게 <span>제대로 질문</span>하는 방법</h2>
    <p>분야와 과제 유형을 선택하면, 실험으로 검증된 최적 조건을 조합해 AI 프롬프트를 자동으로 만들어 드려요.</p>
  </div>

  <div class="steps">
    <div class="step-item active" id="s1">
      <div class="step-num">1</div>
      <div class="step-label">분야 선택</div>
    </div>
    <div class="step-connector"></div>
    <div class="step-item" id="s2">
      <div class="step-num">2</div>
      <div class="step-label">과제 유형</div>
    </div>
    <div class="step-connector"></div>
    <div class="step-item" id="s3">
      <div class="step-num">3</div>
      <div class="step-label">내용 입력</div>
    </div>
    <div class="step-connector"></div>
    <div class="step-item" id="s4">
      <div class="step-num">4</div>
      <div class="step-label">프롬프트 생성</div>
    </div>
  </div>

  <!-- API KEY SECTION -->
  <div class="apikey-section" id="apikeySection">
    <div class="warn-icon">🔑</div>
    <div class="apikey-content">
      <p><strong>Claude API 키 입력</strong><br>
      AI 프롬프트 생성을 위해 Anthropic API 키가 필요해요. <a href="https://console.anthropic.com" target="_blank" style="color:var(--warn);font-weight:600;">console.anthropic.com</a>에서 발급받을 수 있어요. 키는 이 브라우저 세션에만 저장되고 외부로 전송되지 않아요.</p>
      <div class="apikey-row">
        <input type="password" id="apiKeyInput" placeholder="sk-ant-..." />
        <button onclick="saveApiKey()">저장</button>
      </div>
      <div class="apikey-status" id="apiKeyStatus"></div>
    </div>
  </div>

  <!-- STEP 1: FIELD -->
  <div class="section">
    <div class="section-label">① 분야를 선택하세요</div>
    <div class="field-grid">
      <button class="field-btn" onclick="selectField(this,'국어/글쓰기/독서','📝','글쓰기·독서·발표 등')">
        <span class="field-icon">📝</span>
        <span class="field-name">국어/글쓰기</span>
        <span class="field-sub">독서 포함</span>
      </button>
      <button class="field-btn" onclick="selectField(this,'수학/과학','🔬','수식·실험·증명 등')">
        <span class="field-icon">🔬</span>
        <span class="field-name">수학/과학</span>
        <span class="field-sub">실험·증명 포함</span>
      </button>
      <button class="field-btn" onclick="selectField(this,'사회/역사','🌏','역사·사회·지리 등')">
        <span class="field-icon">🌏</span>
        <span class="field-name">사회/역사</span>
        <span class="field-sub">지리 포함</span>
      </button>
      <button class="field-btn" onclick="selectField(this,'영어','🔤','문법·독해·작문 등')">
        <span class="field-icon">🔤</span>
        <span class="field-name">영어</span>
        <span class="field-sub">문법·독해·작문</span>
      </button>
      <button class="field-btn" onclick="selectField(this,'수행평가/발표','🎤','수행평가·프레젠테이션')">
        <span class="field-icon">🎤</span>
        <span class="field-name">수행평가/발표</span>
        <span class="field-sub">PPT·보고서</span>
      </button>
      <button class="field-btn" onclick="selectField(this,'직접 입력','✏️','원하는 분야 직접 입력')">
        <span class="field-icon">✏️</span>
        <span class="field-name">직접 입력</span>
        <span class="field-sub">자유 분야</span>
      </button>
    </div>
    <div id="customFieldWrap" style="margin-top:10px;display:none;">
      <input type="text" id="customField" placeholder="예: 미술, 체육, 음악, 도덕..." style="width:100%;padding:11px 14px;border:1.5px solid var(--border);border-radius:var(--radius-sm);font-size:14px;font-family:inherit;outline:none;color:var(--text);background:var(--surface);" oninput="updateCustomField()" />
    </div>
  </div>

  <!-- STEP 2: TASK TYPE -->
  <div class="section">
    <div class="section-label">② 과제 유형을 선택하세요</div>
    <div class="task-grid">
      <button class="task-btn" onclick="selectTask(this,'개념 설명 요청')">
        <div class="task-check"><div class="task-check-inner"></div></div>
        <span class="task-text">개념 설명 요청</span>
      </button>
      <button class="task-btn" onclick="selectTask(this,'요약 및 정리')">
        <div class="task-check"><div class="task-check-inner"></div></div>
        <span class="task-text">요약 및 정리</span>
      </button>
      <button class="task-btn" onclick="selectTask(this,'문제 풀이 도움')">
        <div class="task-check"><div class="task-check-inner"></div></div>
        <span class="task-text">문제 풀이 도움</span>
      </button>
      <button class="task-btn" onclick="selectTask(this,'글쓰기 피드백')">
        <div class="task-check"><div class="task-check-inner"></div></div>
        <span class="task-text">글쓰기 피드백</span>
      </button>
      <button class="task-btn" onclick="selectTask(this,'자료 조사')">
        <div class="task-check"><div class="task-check-inner"></div></div>
        <span class="task-text">자료 조사</span>
      </button>
      <button class="task-btn" onclick="selectTask(this,'수행평가 준비')">
        <div class="task-check"><div class="task-check-inner"></div></div>
        <span class="task-text">수행평가 준비</span>
      </button>
    </div>
  </div>

  <!-- STEP 3: TOPIC INPUT -->
  <div class="section">
    <div class="section-label">③ 질문하고 싶은 내용을 입력하세요</div>
    <div class="free-input-wrap">
      <textarea id="topicInput" rows="4" placeholder="예: 이차방정식의 근의 공식을 모르겠어요&#10;예: 3.1운동의 원인과 결과를 정리해야 해요&#10;예: 영어 독후감 쓰는 법을 알려주세요" maxlength="300" oninput="updateCharCount()"></textarea>
      <div class="char-count"><span id="charCount">0</span>/300자</div>
    </div>
  </div>

  <!-- GENERATE BUTTON -->
  <div class="generate-wrap">
    <button id="generateBtn" onclick="generate()" disabled>
      <span class="btn-icon">✨</span>
      최적 프롬프트 생성하기
    </button>
  </div>

  <!-- ERROR -->
  <div class="error-box" id="errorBox"></div>

  <!-- LOADING -->
  <div class="loading-wrap" id="loadingWrap">
    <div class="loading-dots">
      <span></span><span></span><span></span>
    </div>
    <div class="loading-text">실험 데이터 기반으로 최적 조건을 조합하고 있어요...</div>
  </div>

  <!-- RESULT -->
  <div id="result">
    <div class="result-header">
      <span class="result-tag">✅ 생성 완료</span>
      <span class="result-title">최적화된 AI 프롬프트</span>
    </div>

    <div class="prompt-box">
      <div class="prompt-box-header">
        <span class="prompt-box-label">📋 복사해서 AI 채팅창에 바로 붙여넣으세요</span>
        <button id="copyBtn" onclick="copyPrompt()">
          📑 복사하기
        </button>
      </div>
      <div id="promptText"></div>
    </div>

    <div id="condTags" class="conditions-row"></div>

    <div style="font-size:13px;font-weight:600;color:var(--text2);margin-bottom:10px;">실험 데이터 기반 예상 점수</div>
    <div class="score-grid" id="scoreGrid"></div>

    <div class="tip-box">
      <div class="tip-icon">💡</div>
      <div class="tip-content" id="tipContent"></div>
    </div>
  </div>

  <div class="footer-note">
    <strong>10학년 학급 개선 프로젝트</strong> · AI 프롬프트 최적화 실험 기반<br>
    표 정리(4.64점) · 단계별 설명(4.62점) 조건이 종합 1·2위 · 실험 데이터 5개 영역 분석 결과
  </div>
</main>

<script>
let selectedField = '';
let selectedTask = '';
let apiKey = '';

const SCORES = {
  '표 정리': { accuracy: 4.5, completeness: 5.0, quality: 4.5, utility: 4.5, structure: 5.0, total: 4.64 },
  '단계별 설명': { accuracy: 4.5, completeness: 4.8, quality: 4.5, utility: 4.8, structure: 4.5, total: 4.62 },
  '예시 포함': { accuracy: 4.5, completeness: 4.5, quality: 4.0, utility: 4.5, structure: 4.5, total: 4.40 },
  '고등학생 타겟': { accuracy: 4.0, completeness: 4.5, quality: 3.5, utility: 4.0, structure: 4.5, total: 4.10 },
};

function saveApiKey() {
  const val = document.getElementById('apiKeyInput').value.trim();
  const status = document.getElementById('apiKeyStatus');
  if (val.startsWith('sk-ant-') && val.length > 20) {
    apiKey = val;
    status.textContent = '✓ API 키가 저장됐어요. 이제 프롬프트를 생성할 수 있어요!';
    status.className = 'apikey-status ok';
    document.getElementById('apikeySection').style.borderColor = '#9fe1cb';
    checkReady();
  } else {
    status.textContent = '⚠ 올바른 API 키 형식이 아니에요. sk-ant-로 시작하는 키를 입력해 주세요.';
    status.className = 'apikey-status no';
  }
}

function selectField(el, name, icon, sub) {
  document.querySelectorAll('.field-btn').forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
  selectedField = name;
  const wrap = document.getElementById('customFieldWrap');
  if (name === '직접 입력') {
    wrap.style.display = 'block';
    selectedField = document.getElementById('customField').value.trim() || '';
  } else {
    wrap.style.display = 'none';
  }
  updateStepIndicator();
  checkReady();
}

function updateCustomField() {
  selectedField = document.getElementById('customField').value.trim();
  checkReady();
}

function selectTask(el, name) {
  document.querySelectorAll('.task-btn').forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
  selectedTask = name;
  updateStepIndicator();
  checkReady();
}

function updateCharCount() {
  const len = document.getElementById('topicInput').value.length;
  document.getElementById('charCount').textContent = len;
  checkReady();
}

function checkReady() {
  const topic = document.getElementById('topicInput').value.trim();
  const ready = selectedField && selectedTask && topic.length >= 5 && apiKey;
  document.getElementById('generateBtn').disabled = !ready;
}

function updateStepIndicator() {
  const s1 = document.getElementById('s1');
  const s2 = document.getElementById('s2');
  const s3 = document.getElementById('s3');
  const s4 = document.getElementById('s4');
  if (selectedField) { s1.classList.add('done'); s1.classList.remove('active'); s2.classList.add('active'); }
  if (selectedTask) { s2.classList.add('done'); s2.classList.remove('active'); s3.classList.add('active'); }
}

async function generate() {
  const topic = document.getElementById('topicInput').value.trim();
  if (!selectedField || !selectedTask || !topic || !apiKey) return;

  document.getElementById('generateBtn').disabled = true;
  document.getElementById('result').style.display = 'none';
  document.getElementById('errorBox').style.display = 'none';
  document.getElementById('loadingWrap').style.display = 'block';

  const systemPrompt = `당신은 AI 프롬프트 최적화 전문가입니다. 
한국 고등학생을 위한 최적의 AI 프롬프트를 만들어야 합니다.

실험으로 검증된 고성능 조건 (반드시 포함):
- ⑤ 표 정리 요구: 종합 4.64점 (1위) - 구조·가독성 5.0점 만점
- ⑧ 단계별 설명 요구: 종합 4.62점 (2위) - 실용성 4.8점
- ② 예시 포함: 종합 4.40점 (3위)
- ③ 고등학생 타겟: 학생 수준에 맞는 설명

반드시 피해야 할 조건:
- ④ 2000자 이상 요구: 내용의 질 2.0점으로 최하위. 절대 사용 금지.

응답 형식: 프롬프트 텍스트만 출력하세요. 설명이나 부연은 없이 바로 프롬프트만.
프롬프트는 학생이 복사해서 AI 채팅창에 바로 붙여넣을 수 있는 형태여야 합니다.
한국어로 작성하세요.`;

  const userMsg = `분야: ${selectedField}
과제 유형: ${selectedTask}
질문 내용: ${topic}

위 정보를 바탕으로, 실험에서 검증된 최적 조건(표 정리 + 단계별 설명 + 예시 포함 + 고등학생 타겟)을 모두 포함한 AI 프롬프트를 만들어 주세요.`;

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01',
        'anthropic-dangerous-direct-browser-access': 'true'
      },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: systemPrompt,
        messages: [{ role: 'user', content: userMsg }]
      })
    });

    if (!res.ok) {
      const err = await res.json();
      throw new Error(err.error?.message || `API 오류: ${res.status}`);
    }

    const data = await res.json();
    const promptText = data.content[0].text;

    document.getElementById('loadingWrap').style.display = 'none';
    showResult(promptText);

  } catch (e) {
    document.getElementById('loadingWrap').style.display = 'none';
    document.getElementById('generateBtn').disabled = false;
    const eb = document.getElementById('errorBox');
    eb.style.display = 'block';
    eb.textContent = '⚠ 오류가 발생했어요: ' + e.message + '\nAPI 키를 다시 확인해 주세요.';
  }
}

function showResult(text) {
  document.getElementById('promptText').textContent = text;

  const condTags = document.getElementById('condTags');
  condTags.innerHTML = `
    <span class="cond-tag top">🥇 표 정리 요구 <span class="cond-score">4.64</span></span>
    <span class="cond-tag top">🥈 단계별 설명 <span class="cond-score">4.62</span></span>
    <span class="cond-tag high">✓ 예시 포함 <span class="cond-score">4.40</span></span>
    <span class="cond-tag good">✓ 고등학생 타겟 <span class="cond-score">4.10</span></span>
  `;

  const labels = ['정확성', '조건 완수도', '내용의 질', '실용성', '구조·가독성'];
  const values = [4.5, 4.9, 4.4, 4.7, 4.9];
  const grid = document.getElementById('scoreGrid');
  grid.innerHTML = labels.map((l, i) => `
    <div class="score-card">
      <div class="score-card-label">${l}</div>
      <div class="score-card-num">${values[i].toFixed(1)}</div>
      <div class="score-bar-wrap"><div class="score-bar" style="width:${values[i]/5*100}%"></div></div>
    </div>
  `).join('');

  document.getElementById('tipContent').innerHTML = `
    <strong>실험 결론:</strong> 표 정리와 단계별 설명 조건을 동시에 사용하면 구조·가독성과 실용성이 크게 높아져요. 
    반면 "길게 써줘" 같은 글자 수 조건은 내용의 질을 <strong>2.0점(최하위)</strong>으로 떨어뜨리므로 절대 사용하지 마세요.
    이 프롬프트는 ${selectedField} + ${selectedTask}에 최적화된 조건으로 생성됐어요.
  `;

  const result = document.getElementById('result');
  result.style.display = 'block';
  result.scrollIntoView({ behavior: 'smooth', block: 'start' });

  document.getElementById('s4').classList.add('active', 'done');
  document.getElementById('generateBtn').disabled = false;
}

function copyPrompt() {
  const text = document.getElementById('promptText').textContent;
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById('copyBtn');
    btn.textContent = '✅ 복사됨!';
    btn.classList.add('copied');
    setTimeout(() => {
      btn.innerHTML = '📑 복사하기';
      btn.classList.remove('copied');
    }, 2000);
  });
}
</script>
</body>
</html>
